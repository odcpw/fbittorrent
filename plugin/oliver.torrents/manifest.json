{
  "schemaVersion": 1,
  "id": "oliver.torrents",
  "name": "Torrents",
  "version": "0.2.0",
  "author": "Oliver",
  "license": "MIT",
  "description": "Torrent status, transfer rates and quick actions in the open fbittorrent app.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Torrents",
    "description": "Active downloads, rates, add from clipboard, open the fbittorrent TUI.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "binary": "fbittorrent",
      "showWhenStopped": false,
      "showRates": false,
      "middleClick": "dashboard",
      "tuiCommand": "omarchy-launch-or-focus-tui --app-id=org.omarchy.fbittorrent fbittorrent tui"
    },
    "schema": [
      {
        "key": "binary",
        "type": "string",
        "label": "binary",
        "defaultValue": "fbittorrent"
      },
      {
        "key": "showWhenStopped",
        "type": "boolean",
        "label": "showWhenStopped",
        "defaultValue": false
      },
      {
        "key": "showRates",
        "type": "boolean",
        "label": "showRates",
        "defaultValue": false
      },
      {
        "key": "middleClick",
        "type": "string",
        "label": "middleClick",
        "defaultValue": "dashboard"
      },
      {
        "key": "tuiCommand",
        "type": "string",
        "label": "tuiCommand",
        "defaultValue": "omarchy-launch-or-focus-tui --app-id=org.omarchy.fbittorrent fbittorrent tui"
      }
    ]
  }
}
