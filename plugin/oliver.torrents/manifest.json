{
  "schemaVersion": 1,
  "id": "oliver.torrents",
  "name": "Torrents",
  "version": "0.1.0",
  "author": "Oliver",
  "license": "MIT",
  "description": "Torrent status, transfer rates and quick actions in the open fbittorrent app.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Torrents",
    "description": "Active downloads, rates, add from clipboard, open the fbittorrent TUI.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 2,
      "idleRefreshIntervalSec": 10,
      "binary": "fbittorrent",
      "tuiCommand": "omarchy-launch-or-focus-tui --app-id=org.omarchy.fbittorrent fbittorrent tui"
    },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh while open (seconds)", "min": 1, "max": 60, "step": 1, "defaultValue": 2 },
      { "key": "idleRefreshIntervalSec", "type": "integer", "label": "Refresh while closed (seconds)", "min": 2, "max": 600, "step": 1, "defaultValue": 10 },
      { "key": "binary", "type": "string", "label": "fbittorrent binary", "defaultValue": "fbittorrent" },
      { "key": "tuiCommand", "type": "string", "label": "TUI launch command", "defaultValue": "omarchy-launch-or-focus-tui --app-id=org.omarchy.fbittorrent fbittorrent tui" }
    ]
  }
}
